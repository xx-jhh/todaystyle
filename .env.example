# todaystyle 로컬 실행용 환경변수 템플릿.
# 이 파일을 복사해 .env 로 만들고 실제 값을 채운다. (.env 는 .gitignore 로 커밋 제외)
# IntelliJ EnvFile 플러그인: Run/Debug Configurations → EnvFile 탭에서 .env 등록.

# --- Database (MySQL) ---
DB_USERNAME=root
DB_PASSWORD=

# --- 기상청 단기예보 API (공공데이터포털) ---
# 발급받은 "일반 인증키(Decoding)" 값을 넣을 것. Encoding 키를 넣으면 이중 인코딩되어 실패한다.
KMA_SERVICE_KEY=

# --- 이미지 저장소 (Cloudinary) ---
# 미발급 상태여도 앱은 부팅되며, 실제 이미지 업로드 시점에만 필요.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- JWT ---
# HS256 서명용 시크릿 (최소 32바이트). 운영에서는 반드시 별도 값으로 교체.
JWT_SECRET=todaystyle-local-dev-secret-key-change-me-please-32bytes
# 액세스 토큰 만료 시간 (밀리초). 기본 24시간.
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# 브라우저에서 API를 직접 호출 가능한 출처(콤마 구분). 기본값은 로컬 Vite 개발 서버만 허용.
# 배포 도메인이 생기면 콤마로 추가할 것(예: https://todaystyle.example.com,http://localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- 비밀번호 재설정 메일 (Gmail SMTP) ---
# Gmail 계정 이메일 + 앱 비밀번호(2단계 인증 켠 뒤 myaccount.google.com에서 발급, 16자리).
# 미설정이어도 앱은 부팅되지만 재설정 메일 발송은 조용히 실패한다(로그에만 남음).
SMTP_USERNAME=
SMTP_PASSWORD=

# 재설정 메일 링크(.../reset-password?token=...)를 만들 때 쓰는 프론트 오리진.
# 배포 시 실제 서비스 도메인으로 바꿀 것(예: https://43-200-41-206.sslip.io).
APP_BASE_URL=http://localhost:5173

# --- 에러 알림 (Discord 웹훅) ---
# 서버에서 ERROR 로그가 찍히면 이 웹훅으로 알림을 보낸다. 미설정이어도 앱은 정상 동작.
DISCORD_WEBHOOK_URL=
